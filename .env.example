# ─────────────────────────────────────────────────────────────
# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Map (required for the interactive map) ───────────────────
# Create a PUBLIC token (starts with pk.) at https://account.mapbox.com/access-tokens/
# Restrict it to your production URL(s) in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the map starts if the user denies location access
NEXT_PUBLIC_DEFAULT_LAT=48.8566
NEXT_PUBLIC_DEFAULT_LNG=2.3522
NEXT_PUBLIC_DEFAULT_PLACE=Paris

# ── Accounts & sessions (host / guest sign-in) ───────────────
# Signs the session cookie. REQUIRED in production, optional locally
# (a dev-only fallback is used so `npm run dev` works with nothing set).
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Your site's public URL. Needed in production if you don't deploy on Vercel
# (Vercel is detected automatically). Locally you can leave it empty.
# NEXTAUTH_URL=https://your-domain.com

# ── Database for hosts, listings, units and bookings ─────────────
# Pick ONE (checked in this order). Leave all empty to use a local JSON file
# in .data/ — zero setup, fine for local development and demos.
#
# 1) Supabase (hosted Postgres) — recommended for production / Vercel.
#    Run supabase/schema.sql in the Supabase SQL editor first, and create a
#    PUBLIC storage bucket named "listing-photos" for photo uploads.
#    The service-role key is SECRET: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# 2) Prisma + SQLite for local development:
#    DATABASE_URL="file:./dev.db"   then:  npm run db:generate && npm run db:push
#    (Prisma reads .env, not .env.local — put this one in .env)
# DATABASE_URL="file:./dev.db"

# ── Marketplace behaviour & storage (all optional) ───────────────
# Set to "false" to show ONLY host-created listings (no mock/Apify results).
INCLUDE_EXTERNAL_LISTINGS=true
# Override where the JSON database / uploaded photos are stored locally.
# DATA_DIR=
# UPLOAD_DIR=

# ── Listings data source ─────────────────────────────────────
# Leave both empty to use the built-in mock data (default).
# To use a real scraper, set both. See README → "Using real listings".
APIFY_TOKEN=
APIFY_ACTOR_ID=

# ── Affiliate / monetisation (server-side only) ──────────────
# Option A – append query params to every Airbnb URL, e.g. "af=12345&c=aam"
AFFILIATE_PARAMS=
# Option B – wrap the URL in a tracking link from your affiliate network.
# {url} is replaced with the URL-encoded Airbnb link.
# e.g. "https://your-network.example/click?id=123&u={url}"
AFFILIATE_LINK_TEMPLATE=

# ── Push notifications for price drops (optional) ────────────
# Generate keys with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
