# ─────────────────────────────────────────────────────────────
# Copy to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Map (required for the interactive map) ───────────────────
# Create a PUBLIC token (starts with pk.) at https://account.mapbox.com/access-tokens/
# Restrict it to your production URL(s) in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the map starts if the user denies location access
NEXT_PUBLIC_DEFAULT_LAT=48.8566
NEXT_PUBLIC_DEFAULT_LNG=2.3522
NEXT_PUBLIC_DEFAULT_PLACE=Paris

# ── Listings data source ─────────────────────────────────────
# Leave both empty to use the built-in mock data (default).
# To use a real scraper, set both. See README → "Using real listings".
APIFY_TOKEN=
APIFY_ACTOR_ID=

# ── Affiliate / monetisation (server-side only) ──────────────
# Option A – append query params to every Airbnb URL, e.g. "af=12345&c=aam"
AFFILIATE_PARAMS=
# Option B – wrap the URL in a tracking link from your affiliate network.
# {url} is replaced with the URL-encoded Airbnb link.
# e.g. "https://your-network.example/click?id=123&u={url}"
AFFILIATE_LINK_TEMPLATE=

# ── Push notifications for price drops (optional) ────────────
# Generate keys with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
